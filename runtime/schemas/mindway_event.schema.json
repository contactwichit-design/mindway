{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindway.example/schemas/mindway_event.schema.json",
  "title": "Mindway Runtime Event",
  "type": "object",
  "required": ["schema_version", "event_id", "run_id", "type", "timestamp", "sequence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "parent_event_id": {"type": ["string", "null"]},
    "type": {"type": "string", "enum": ["run.created","orient.started","plan.created","route.selected","work.started","work.completed","tool.called","tool.succeeded","tool.failed","verify.started","verify.pass","verify.fail","fix.started","fix.completed","improvement.proposed","approval.required","checkpoint.saved","run.resumed","run.completed","run.stopped"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "sequence": {"type": "integer", "minimum": 0},
    "cycle": {"type": "integer", "minimum": 0},
    "actor": {"type": ["string", "null"]},
    "subject": {"type": ["string", "null"]},
    "status": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "payload": {"type": "object", "additionalProperties": true},
    "redaction": {"type": "object", "properties": {"applied": {"type": "boolean"}, "fields": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
