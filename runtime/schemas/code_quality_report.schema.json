{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindway.dev/schemas/code_quality_report.schema.json",
  "title": "Mindway Code Quality Gate Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "baseline",
    "verdict",
    "findings",
    "checks",
    "promotion"
  ],
  "properties": {
    "version": {"type": "string"},
    "target": {"type": "string", "minLength": 1},
    "baseline": {"type": ["string", "null"]},
    "verdict": {
      "enum": ["PASS", "PASS_WITH_DEBT", "REPAIR_REQUIRED", "BLOCKED_BY_INVARIANT"]
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lint", "typecheck", "tests", "security", "quality_scan"],
      "properties": {
        "lint": {"$ref": "#/$defs/check"},
        "typecheck": {"$ref": "#/$defs/check"},
        "tests": {"$ref": "#/$defs/check"},
        "security": {"$ref": "#/$defs/check"},
        "quality_scan": {"$ref": "#/$defs/check"}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tech_valid", "quality_gate_passed", "independent_review_required", "review_ready"],
      "properties": {
        "tech_valid": {"type": "boolean"},
        "quality_gate_passed": {"type": "boolean"},
        "independent_review_required": {"type": "boolean"},
        "review_ready": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "family",
        "observation",
        "evidence",
        "defect",
        "severity",
        "repair",
        "confidence"
      ],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^CQG-[A-Z]+-[0-9]{3}$"},
        "family": {"type": "string"},
        "observation": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "message"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "line": {"type": ["integer", "null"], "minimum": 1},
              "message": {"type": "string", "minLength": 1}
            }
          }
        },
        "defect": {"type": "string", "minLength": 1},
        "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "BLOCKER"]},
        "repair": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "invariant": {"type": ["string", "null"]},
        "accepted_debt": {"type": "boolean", "default": false}
      }
    }
  }
}